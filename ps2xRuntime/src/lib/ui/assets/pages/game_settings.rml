<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="../theme/fpr.rcss"/>
</head>
<body>
    <div id="window">
        <div id="header">
            <span id="brand">Fire Pro Wrestling Returns</span>
            <span id="page-title">Settings</span>
        </div>

        <div id="tabs">
            <div class="tab selected" id="tab-graphics" data-tab="graphics" data-help="Picture options.">Graphics</div>
            <div class="tab" id="tab-audio" data-tab="audio" data-help="Sound options.">Audio</div>
            <div class="tab" id="tab-controls" data-tab="controls" data-help="The keys and buttons the game uses.">Controls</div>
        </div>

        <div class="panel" id="panel-graphics">
            <div class="row" data-kind="choice" data-key="renderer" data-name="Renderer" data-choices="gpu|cpu" data-labels="GPU|CPU"
                 data-value="gpu" data-restart="1"
                 data-help="GPU is fast; CPU is the slow fallback. Needs a restart.">
                <span class="label">Renderer</span><span class="tag"></span><span class="value">[GPU]</span>
            </div>
            <div class="row" data-kind="choice" data-key="resolution" data-name="Internal Resolution" data-choices="1|2|3|4"
                 data-labels="1x|2x|3x|4x" data-value="1" data-restart="1"
                 data-help="How sharply 3D is drawn. 1x is the original. Needs a restart.">
                <span class="label">Internal Resolution</span><span class="tag"></span><span class="value">[1x]</span>
            </div>
            <div class="row" data-kind="choice" data-key="aspect" data-name="Aspect Ratio" data-choices="4:3|16:9|21:9" data-value="4:3"
                 data-restart="1"
                 data-help="Wider shows more of the ring; menus stay 4:3. Needs a restart.">
                <span class="label">Aspect Ratio</span><span class="tag"></span><span class="value">[4:3]</span>
            </div>
            <div class="row" data-kind="toggle" data-key="fullscreen" data-value="off"
                 data-help="Fill the whole screen instead of a window.">
                <span class="label">Full Screen</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <div class="row" data-kind="toggle" data-key="vsync" data-value="off"
                 data-help="Wait for the screen to refresh. Stops tearing.">
                <span class="label">V-Sync</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <div class="row" data-kind="choice" data-key="filter" data-name="Picture Filter" data-choices="sharp|linear"
                 data-labels="Sharp|Linear" data-value="sharp"
                 data-help="Sharp keeps pixels crisp, Linear smooths them.">
                <span class="label">Picture Filter</span><span class="tag"></span><span class="value">[Sharp]</span>
            </div>
        </div>

        <div class="panel hidden" id="panel-audio">
            <div class="row" data-kind="slider" data-key="volume" data-min="0" data-max="100" data-step="5" data-value="100"
                 data-suffix="%" data-help="How loud the game is.">
                <span class="label">Master Volume</span>
                <span class="tag"></span>
                <div class="slider"><div class="track"><div class="fill"></div></div></div>
                <span class="value">[100%]</span>
            </div>
        </div>

        <div class="panel hidden" id="panel-controls">
            <div id="controls-list"></div>
            <div id="controller-name"></div>
        </div>

        <div id="notice"><span id="restart-note" class="hidden"></span></div>
        <div id="help"><span id="help-text"></span></div>

        <div id="footer">
            <div id="hints"><span>A: Change</span><span>B: Back</span><span>LB / RB: Tab</span></div>
            <!-- Back comes first in the document, so that Down from the last row lands on Back as it always did; the row
                 is laid out in reverse, which puts Back at the right edge with Quit Game on its left. -->
            <div id="footer-buttons">
                <div class="button" id="back" data-help="Save the settings and go back to the game.">Back</div>
                <div class="button" id="quit" data-help="Close the game and return to the desktop.">Quit Game</div>
            </div>
        </div>
    </div>

    <!-- Quit Game asks first. Cancel is the button that gets the focus, so a stray press cannot quit. -->
    <div id="confirm" class="hidden">
        <div id="confirm-box">
            <div id="confirm-title">Quit to the desktop?</div>
            <div id="confirm-text">Anything not saved to the memory card is lost.</div>
            <div id="confirm-buttons">
                <div class="button" id="confirm-yes" data-help="Close the game and return to the desktop.">Quit</div>
                <div class="button" id="confirm-no" data-help="Stay in the game.">Cancel</div>
            </div>
        </div>
    </div>
</body>
</rml>
