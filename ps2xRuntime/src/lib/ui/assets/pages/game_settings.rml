<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="../theme/fpr.rcss"/>
</head>
<body>
    <!-- The page fills the window. Top to bottom: the title band (the full width), then one centred column with the tabs, the content
         box (one .panel per tab; the one showing takes all the room that is left, so every tab has the same frame), the restart
         note, the help line and the footer. -->
    <div id="window">
        <div id="header">
            <span id="page-title">Settings</span>
            <span id="brand">Fire Pro Wrestling Returns</span>
        </div>

        <!-- Everything under the title band is one column, centred, with a maximum width (#page in the theme). -->
        <div id="page">
        <div id="tabs">
            <div class="tab selected" id="tab-graphics" data-tab="graphics" data-help="Picture options.">Graphics</div>
            <div class="tab" id="tab-audio" data-tab="audio" data-help="Sound options.">Audio</div>
            <div class="tab" id="tab-controls" data-tab="controls" data-help="The keys and buttons the game uses.">Controls</div>
            <div class="tab" id="tab-gameplay" data-tab="gameplay" data-help="Changes to how matches play. Original keeps the game as it was.">Gameplay</div>
            <!-- The Mods tab (panel-mods, mod-confirm) is removed by the menu when the game has no mod manager. -->
            <div class="tab" id="tab-mods" data-tab="mods" data-help="Install, turn on and off, and order mods.">Mods</div>
        </div>

        <div class="panel" id="panel-graphics">
            <div class="row" data-kind="choice" data-key="renderer" data-name="Renderer" data-choices="gpu|cpu" data-labels="GPU|CPU"
                 data-value="gpu" data-restart="1"
                 data-help="GPU is fast; CPU is the slow fallback. Needs a restart.">
                <span class="label">Renderer</span><span class="tag"></span><span class="value">[GPU]</span>
            </div>
            <div class="row" data-kind="choice" data-key="resolution" data-name="Internal Resolution" data-choices="1|2|3|4"
                 data-labels="1x|2x|3x|4x" data-value="1" data-restart="1"
                 data-help="How sharply 3D is drawn. 1x is the original. Needs a restart.">
                <span class="label">Internal Resolution</span><span class="tag"></span><span class="value">[1x]</span>
            </div>
            <div class="row" data-kind="choice" data-key="aspect" data-name="Aspect Ratio" data-choices="4:3|16:9|21:9" data-value="4:3"
                 data-restart="1"
                 data-help="Wider shows more of the ring; menus stay 4:3. Needs a restart.">
                <span class="label">Aspect Ratio</span><span class="tag"></span><span class="value">[4:3]</span>
            </div>
            <div class="row" data-kind="toggle" data-key="fullscreen" data-value="off"
                 data-help="Fill the whole screen instead of a window.">
                <span class="label">Full Screen</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <div class="row" data-kind="toggle" data-key="vsync" data-value="off"
                 data-help="Wait for the screen to refresh. Stops tearing.">
                <span class="label">V-Sync</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <div class="row" data-kind="choice" data-key="filter" data-name="Picture Filter" data-choices="sharp|linear"
                 data-labels="Sharp|Linear" data-value="sharp"
                 data-help="Sharp keeps pixels crisp, Linear smooths them.">
                <span class="label">Picture Filter</span><span class="tag"></span><span class="value">[Sharp]</span>
            </div>
            <!-- Task fx1 (src/lib/gpu/gpu_postfx.h): screen effects in matches, off by default, applied at once. Every value of the look can be
                 tuned in the debug panel (F1, Effects tab); these two rows are the on/off switch and the preset. -->
            <div class="row" data-kind="toggle" data-key="fx" data-name="Screen Effects" data-value="off"
                 data-help="Soft glow, colour grading, a miniature-style blur and a vignette on the match picture. Menus and the clock are left alone. Applies at once.">
                <span class="label">Screen Effects</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <div class="row" data-kind="choice" data-key="fx_preset" data-name="Effects Look" data-choices="subtle|strong|off"
                 data-labels="Subtle|Strong|Off" data-value="subtle"
                 data-help="How strong the screen effects are when they are on. Applies at once.">
                <span class="label">Effects Look</span><span class="tag"></span><span class="value">[Subtle]</span>
            </div>
            <div class="row" data-kind="toggle" data-key="texture_tools" data-name="Texture Tools" data-value="off" data-restart="1"
                 data-help="For modders: dump textures and see edits at once. Needs a restart.">
                <span class="label">Texture Tools</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
            <!-- Task i1 owns the setting (key skip_intros, off by default); this row only shows and changes it. -->
            <div class="row" data-kind="toggle" data-key="skip_intros" data-name="Skip Intros" data-value="off" data-restart="1"
                 data-help="Start at the title screen without the opening logos and movie. Applies at the next start.">
                <span class="label">Skip Intros</span><span class="tag"></span><span class="value">[OFF]</span>
            </div>
        </div>

        <div class="panel hidden" id="panel-audio">
            <div class="row" data-kind="slider" data-key="volume" data-min="0" data-max="100" data-step="5" data-value="100"
                 data-suffix="%" data-help="How loud the game is.">
                <span class="label">Master Volume</span>
                <span class="tag"></span>
                <div class="slider"><div class="track"><div class="fill"></div></div></div>
                <span class="value">[100%]</span>
            </div>
        </div>

        <div class="panel hidden" id="panel-controls">
            <div id="controls-list"></div>
            <div id="controller-name"></div>
        </div>

        <div class="panel hidden" id="panel-gameplay">
            <!-- Task s1 (src/overrides/fpwr_gameplay.cpp in the game repo): Original runs the game's own hit test, untouched. -->
            <div class="row" data-kind="choice" data-key="strike_depth" data-name="Strike Depth" data-choices="original|wide|wider"
                 data-labels="Original|Wide|Wider" data-value="original"
                 data-help="How far off the target's line (toward or away from the screen) a strike still lands. Wide is 1.5x, Wider 2x. Applies at once.">
                <span class="label">Strike Depth</span><span class="tag"></span><span class="value">[Original]</span>
            </div>
        </div>

        <!-- The Mods tab: the list on the left and the details of the focused mod on the right are filled in by ui_mods.cpp. -->
        <div class="panel hidden" id="panel-mods">
            <div id="mods-body">
                <div id="mods-list"></div>
                <div id="mod-details"></div>
            </div>
            <div id="mods-status"></div>
            <div id="mods-foot">
                <!-- Which memory card is in use and why: the whole width, and it wraps. -->
                <div id="mods-card"></div>
                <!-- Load Now (task h1): shown while data-pack changes wait to be applied to the running game. The line beside it says what is going on. -->
                <div id="mods-apply">
                    <div class="mbtn small" id="load-now" data-help="Load the memory card again now, with the data packs as they are (asks first).">Load Now</div>
                    <div id="mods-load-note"></div>
                </div>
                <div id="mods-lower">
                    <!-- The folder lines are shortened in the middle by the code, and clipped here as a last resort, so they never run under the buttons. -->
                    <div id="mods-paths">
                        <div id="mods-folder"></div>
                        <div id="dev-folder"></div>
                    </div>
                    <div id="mods-tools">
                        <div class="mbtn small wide" id="import-save" data-help="Import a community save as a data pack (or drop it on the window).">Import a Save...</div>
                        <div class="mbtn small" id="keep-card" data-help="Copy the profile card's save to your own card (asks first).">Keep Card</div>
                        <div class="mbtn small" id="back-card" data-help="Play from your own memory card from the next start (asks first).">Back to My Card</div>
                        <div class="mbtn small" id="dump-textures" data-help="For modders: save this screen's textures and text to a dumps folder.">Dump Textures</div>
                        <div class="mbtn small" id="open-dumps" data-help="For modders: open the folder the texture dumps go to.">Dumps Folder</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="notice">
            <span id="restart-note" class="hidden"></span>
            <!-- Restart Now (task h1): shown with the note; the Mods tab asks first and starts the game again. -->
            <div class="button compact" id="restart-now" data-help="Close the game and start it again to apply the changes (asks first).">Restart Now</div>
        </div>
        <div id="help"><span id="help-text"></span></div>

        <div id="footer">
            <div id="hints"><span>A: Change</span><span>B: Back</span><span>LB / RB: Tab</span></div>
            <!-- Back comes first in the document, so that Down from the last row lands on Back as it always did; the row
                 is laid out in reverse, which puts Back at the right edge with Quit Game on its left. -->
            <div id="footer-buttons">
                <div class="button" id="back" data-help="Save the settings and go back to the game.">Back</div>
                <div class="button" id="quit" data-help="Close the game and return to the desktop.">Quit Game</div>
            </div>
        </div>
        </div>
    </div>

    <!-- Uninstalling a mod asks first, the same way. -->
    <div id="mod-confirm" class="hidden">
        <div id="mod-confirm-box">
            <div id="mod-confirm-title">Uninstall this mod?</div>
            <div id="mod-confirm-text"></div>
            <div id="mod-confirm-buttons">
                <div class="button" id="mod-confirm-yes" data-help="Move the mod's file to the .trash folder.">Uninstall</div>
                <!-- The "which save?" question has up to three answers; these two are shown only then. -->
                <div class="button hidden" id="mod-confirm-alt1" data-help="Import this save.">Second</div>
                <div class="button hidden" id="mod-confirm-alt2" data-help="Import this save.">Third</div>
                <div class="button" id="mod-confirm-no" data-help="Keep the mod.">Cancel</div>
            </div>
        </div>
    </div>

    <!-- Quit Game asks first. Cancel is the button that gets the focus, so a stray press cannot quit. -->
    <div id="confirm" class="hidden">
        <div id="confirm-box">
            <div id="confirm-title">Quit to the desktop?</div>
            <div id="confirm-text">Anything not saved to the memory card is lost.</div>
            <div id="confirm-buttons">
                <div class="button" id="confirm-yes" data-help="Close the game and return to the desktop.">Quit</div>
                <div class="button" id="confirm-no" data-help="Stay in the game.">Cancel</div>
            </div>
        </div>
    </div>
</body>
</rml>
