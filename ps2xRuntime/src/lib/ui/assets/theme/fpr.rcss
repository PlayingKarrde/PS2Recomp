/*
 * Theme "fpr": the overlay's look, taken from the menus of Fire Pro Wrestling Returns.
 *
 * What the game's own screens look like (from screenshots of its Options, wrestler select, edit and main menu):
 *   - panels: near-black translucent fill with a thick cream border (#d1caaf, about 4 px at 640x480) and rounded
 *     corners, drawn over a busy yellow and grey background;
 *   - the cursor is a bar across the row, a steel-blue vertical gradient (#2c68a3 at the top to #4d8cc6), with
 *     the row's text staying white;
 *   - all text is white, bold and italic, widely spaced, with a black drop shadow;
 *   - values sit at the right of a row in square brackets, "[Stereo]", "[85%]", "[OFF]";
 *   - a description of the highlighted row in a separate bar at the bottom ("Adjust sound options.");
 *   - the main menu's items are khaki bevelled bars (#c3bda4, light top edge, dark underside) under a gold band
 *     (#cba32c to #e7bc3d); scroll bars are a bright blue thumb (#40a0ff) in a cream frame.
 *
 * Nothing from the game is used here: the font is Lato (SIL OFL 1.1, ../fonts), the colours are measured from the
 * screenshots, the shapes are RCSS. Using the game's own font (fpr.fnt on the disc) and textures at run time would
 * be a later step and is not needed for this look.
 *
 * Units: dp, the UI scale (1 dp = 1 pixel in a 720 pixel high window).
 * RmlUi limits the theme works within: no box-shadow or filters (the renderer has no offscreen layers), so depth
 * comes from borders and gradients.
 */

/* RmlUi has no built-in HTML defaults: an element is inline unless told otherwise, which makes a div ignore its
   width and height. The samples ship rml.rcss for this; the theme needs only div. */
div
{
    display: block;
}

body
{
    font-family: LatoLatin;
    font-weight: bold;
    font-style: italic;
    font-size: 28dp;
    letter-spacing: 1.8dp;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    /* A dim over the whole game picture, so the overlay reads as in front of it. */
    background-color: #00000078;
}

/* ---- The window: a gold title band over the panels ---------------------------------------------------- */

#window
{
    width: 960dp;
    padding: 0;
}

#header
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 46dp;
    padding: 0 20dp;
    decorator: linear-gradient(180deg, #cba32c, #e7bc3d 70%, #d4ac32);
    border-bottom: 3dp #7b735d;
    border-top-left-radius: 10dp;
    border-top-right-radius: 10dp;
}

#brand
{
    font-size: 18dp;
    font-weight: normal;
    font-effect: none;
    color: #1c1a14;
}

#page-title
{
    font-size: 30dp;
    color: #1c1a14;
    font-effect: shadow(1dp 1dp #f6e7a8);
}

/* ---- Tabs: khaki bars like the main menu's items; the current one takes the blue cursor ------------------- */

#tabs
{
    display: flex;
    flex-direction: row;
    padding: 12dp 0 0 0;
}

.tab
{
    display: block;
    tab-index: auto;
    nav: auto;
    width: 210dp;
    height: 52dp;
    margin-right: 10dp;
    padding-top: 9dp;
    text-align: center;
    color: #1c1a14;
    font-effect: outline(1dp #ffffff);
    decorator: linear-gradient(180deg, #efefef, #c3bda4 14%, #a59f89 80%, #6b6759);
    border: 2dp #3c3b32;
    border-radius: 4dp;
}

.tab:hover
{
    decorator: linear-gradient(180deg, #ffffff, #d8d2b8 14%, #b8b29a 80%, #7c7868);
}

.tab.selected
{
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
    decorator: linear-gradient(180deg, #2c68a3, #4d8cc6);
    border-color: #d1caaf;
}

.tab:focus
{
    border-color: #ffffff;
}

/* ---- Panels: dark, translucent, cream border, rounded ----------------------------------------------------- */

.panel
{
    box-sizing: border-box;
    margin-top: 10dp;
    padding: 12dp 14dp;
    background-color: #000000d6;
    border: 5dp #d1caaf;
    border-radius: 10dp;
}

.row
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    height: 52dp;
    padding: 0 14dp;
    border-radius: 3dp;
}

.row:hover,
.row:focus
{
    decorator: linear-gradient(180deg, #2c68a3, #3a76b2 45%, #4d8cc6);
}

.row .label
{
    flex: 1 1 0;
}

.row .value
{
    width: 150dp;
    text-align: right;
}

/* A slider is a cream-framed dark trough with a blue fill, between the label and the value. */
.row .slider
{
    width: 300dp;
    height: 20dp;
    margin-right: 18dp;
}

.row .track
{
    width: 100%;
    height: 20dp;
    box-sizing: border-box;
    background-color: #000000;
    border: 3dp #d1caaf;
    border-radius: 10dp;
    overflow: hidden;
}

.row .fill
{
    width: 50%;
    height: 14dp;
    decorator: linear-gradient(180deg, #8ec7ff, #40a0ff 45%, #2a68a6);
}

.row:focus .track
{
    border-color: #ffffff;
}

/* ---- The help line and the footer ------------------------------------------------------------------------ */

#help
{
    box-sizing: border-box;
    margin-top: 10dp;
    height: 58dp;
    padding: 8dp 14dp 0 14dp;
    text-align: center;
    background-color: #000000d6;
    border: 5dp #d1caaf;
    border-radius: 10dp;
}

#footer
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12dp;
}

#hints
{
    font-size: 19dp;
    font-weight: normal;
    color: #e6e0c8;
    /* Over a bright game picture the bare text is hard to read. */
    padding: 5dp 14dp 3dp 14dp;
    background-color: #000000b4;
    border-radius: 6dp;
}

#hints span
{
    margin-right: 22dp;
}

.button
{
    display: block;
    tab-index: auto;
    nav: auto;
    width: 190dp;
    height: 50dp;
    padding-top: 9dp;
    text-align: center;
    color: #1c1a14;
    font-effect: outline(1dp #ffffff);
    decorator: linear-gradient(180deg, #efefef, #c3bda4 14%, #a59f89 80%, #6b6759);
    border: 2dp #3c3b32;
    border-radius: 4dp;
}

.button:hover,
.button:focus
{
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
    decorator: linear-gradient(180deg, #2c68a3, #4d8cc6);
    border-color: #d1caaf;
}

/* ---- In the game: row tags, locked rows, the restart note and the read-only controls list --------------- */

/* A short word in a row ("ENV", "RESTART"); the space is kept so values do not move. */
.row .tag
{
    width: 130dp;
    margin-right: 10dp;
    text-align: right;
    font-size: 16dp;
    color: #e7bc3d;
    letter-spacing: 1dp;
}

/* A locked row can still be focused (the help line says why) but is dimmed. */
.row.locked .label,
.row.locked .value
{
    color: #8f8c80;
    font-effect: none;
}

.row.locked .track
{
    border-color: #8f8c80;
}

#notice
{
    height: 30dp;
    margin-top: 6dp;
    text-align: center;
}

#help
{
    font-size: 24dp;
}

#restart-note
{
    font-size: 20dp;
    font-weight: normal;
    color: #e7bc3d;
    letter-spacing: 1dp;
}

/* The panels of the game's settings page are the same height, so the window does not jump between tabs. The Mods tab needs
   the room for a list and a details page side by side. */
#window .panel
{
    min-height: 400dp;
}

.ctl
{
    display: flex;
    flex-direction: row;
    height: 23dp;
    padding: 0 14dp;
    font-size: 17dp;
    letter-spacing: 1dp;
}

.ctl .c-act
{
    width: 150dp;
}

.ctl .c-key
{
    flex: 1 1 0;
    color: #e6e0c8;
}

.ctl .c-pad
{
    width: 340dp;
}

.ctl.head
{
    color: #e7bc3d;
    margin-bottom: 4dp;
    border-bottom: 2dp #d1caaf;
}

#controller-name
{
    margin-top: 10dp;
    padding: 0 14dp;
    font-size: 16dp;
    font-weight: normal;
    color: #e6e0c8;
}

/* ---- Quit Game and its question ------------------------------------------------------------------------- */

#footer-buttons
{
    display: flex;
    flex-direction: row-reverse; /* Back (first in the page) at the right edge, Quit Game on its left */
}

#quit
{
    margin-right: 14dp;
}

/* A button that cannot be used now (Quit Game while the game is writing to the memory card). It stays focusable, so the
   help line can say why. */
.button.locked
{
    color: #6e6b60;
    font-effect: none;
    decorator: linear-gradient(180deg, #8d8a7c, #7a7769 14%, #67645a 80%, #4a483f);
}

.button.locked:hover,
.button.locked:focus
{
    color: #cfcbbb;
    border-color: #d1caaf;
}

/* While the question is up, nothing behind it takes the focus (the controller's directions would otherwise walk off the
   question into the settings). The mouse cannot reach the settings either: the question's dim layer covers them. */
#window.confirming
{
    focus: none;
}

#confirm
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #000000b4;
}

#confirm-box
{
    box-sizing: border-box;
    width: 640dp;
    padding: 26dp 30dp 30dp 30dp;
    text-align: center;
    background-color: #000000f2;
    border: 5dp #d1caaf;
    border-radius: 10dp;
}

#confirm-title
{
    font-size: 34dp;
}

#confirm-text
{
    margin: 14dp 0 26dp 0;
    font-size: 22dp;
    font-weight: normal;
    color: #e6e0c8;
}

#confirm-buttons
{
    display: flex;
    flex-direction: row;
    justify-content: center;
}

#confirm-buttons .button
{
    margin: 0 12dp;
}

/* ---- The Mods tab: a list of mods on the left, the details of the focused mod on the right ----------------- */

#panel-mods
{
    padding: 10dp 12dp;
}

#mods-body
{
    display: flex;
    flex-direction: row;
    height: 318dp;
}

#mods-list
{
    width: 330dp;
    height: 318dp;
    margin-right: 14dp;
    overflow-y: auto;
}

#mods-empty
{
    padding: 14dp;
    font-size: 20dp;
    font-weight: normal;
    color: #e6e0c8;
}

.mod
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    height: 42dp;
    padding: 0 8dp;
    font-size: 21dp;
    letter-spacing: 1dp;
    border-radius: 3dp;
    border-left: 4dp #00000000;
}

.mod:hover,
.mod:focus
{
    decorator: linear-gradient(180deg, #2c68a3, #3a76b2 45%, #4d8cc6);
}

.mod.selected
{
    border-left-color: #e7bc3d;
}

.mod .m-pos
{
    width: 30dp;
    font-size: 16dp;
    font-weight: normal;
    color: #cfcbbb;
}

.mod .m-name
{
    flex: 1 1 0;
    height: 26dp;
    overflow: hidden;
    white-space: nowrap;
}

.mod .m-flag
{
    width: 18dp;
    text-align: center;
    color: #e7bc3d;
}

.mod .m-state
{
    width: 50dp;
    text-align: right;
    font-size: 19dp;
}

.mod.off .m-name,
.mod.off .m-state
{
    color: #b3af9b;
    font-effect: none;
}

.mod.bad .m-name,
.mod.bad .m-state
{
    color: #ff9d8a;
}

#mod-details
{
    flex: 1 1 0;
    height: 318dp;
}

/* Everything but the buttons scrolls (a long description, many settings); the buttons below stay in view. */
#mod-info
{
    height: 266dp;
    overflow-y: auto;
}

#mod-title
{
    height: 38dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 29dp;
}

#mod-meta
{
    height: 24dp;
    margin-bottom: 6dp;
    font-size: 16dp;
    font-weight: normal;
    letter-spacing: 0.5dp;
    color: #e7bc3d;
    overflow: hidden;
    white-space: nowrap;
}

#mod-main
{
    display: flex;
    flex-direction: row;
}

#mod-text
{
    flex: 1 1 0;
}

#mod-desc
{
    max-height: 84dp;
    overflow: hidden;
    font-size: 18dp;
    font-weight: normal;
    letter-spacing: 0.5dp;
    color: #f2eedc;
}

#mod-problem
{
    margin-top: 6dp;
    font-size: 17dp;
    font-weight: normal;
    letter-spacing: 0.5dp;
}

#mod-problem.bad
{
    color: #ff9d8a;
}

#mod-problem.warn
{
    color: #e7bc3d;
}

#mod-links,
#mod-note
{
    margin-top: 6dp;
    font-size: 15dp;
    font-weight: normal;
    letter-spacing: 0.5dp;
    color: #cfcbbb;
}

#mod-picbox
{
    width: 168dp;
    height: 94dp;
    margin: 4dp 0 0 12dp;
    overflow: hidden;
    border: 2dp #d1caaf;
    background-color: #000000;
}

#mod-pic
{
    width: 164dp;
}

#mod-settings
{
    margin-top: 6dp;
}

.mrow
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    height: 34dp;
    padding: 0 8dp;
    font-size: 19dp;
    letter-spacing: 0.8dp;
    border-radius: 3dp;
}

.mrow:hover,
.mrow:focus
{
    decorator: linear-gradient(180deg, #2c68a3, #3a76b2 45%, #4d8cc6);
}

.mrow .label
{
    flex: 1 1 0;
}

.mrow .value
{
    width: 150dp;
    text-align: right;
}

#mod-actions
{
    display: flex;
    flex-direction: row;
    height: 40dp;
    margin-top: 10dp;
}

.mbtn
{
    display: block;
    tab-index: auto;
    nav: auto;
    width: 128dp;
    height: 38dp;
    margin-right: 8dp;
    padding-top: 6dp;
    font-size: 18dp;
    letter-spacing: 0.8dp;
    text-align: center;
    color: #1c1a14;
    font-effect: outline(1dp #ffffff);
    decorator: linear-gradient(180deg, #efefef, #c3bda4 14%, #a59f89 80%, #6b6759);
    border: 2dp #3c3b32;
    border-radius: 4dp;
}

.mbtn:hover,
.mbtn:focus
{
    color: #ffffff;
    font-effect: shadow(2dp 2dp #000000);
    decorator: linear-gradient(180deg, #2c68a3, #4d8cc6);
    border-color: #d1caaf;
}

.mbtn.locked
{
    color: #6e6b60;
    font-effect: none;
    decorator: linear-gradient(180deg, #8d8a7c, #7a7769 14%, #67645a 80%, #4a483f);
}

.mbtn.locked:hover,
.mbtn.locked:focus
{
    color: #cfcbbb;
    border-color: #d1caaf;
}

#mods-status
{
    height: 22dp;
    margin-top: 8dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 17dp;
    font-weight: normal;
    letter-spacing: 0.5dp;
    color: #e7bc3d;
}

#mods-folder
{
    height: 20dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 14dp;
    font-weight: normal;
    letter-spacing: 0.3dp;
    color: #cfcbbb;
}

/* Scroll bars (a list or a details page longer than its box): a cream-framed trough with the blue thumb of the game's own lists. */
scrollbarvertical
{
    width: 12dp;
}

scrollbarvertical slidertrack
{
    background-color: #000000a0;
}

scrollbarvertical sliderbar
{
    width: 12dp;
    min-height: 24dp;
    background-color: #40a0ff;
    border: 2dp #d1caaf;
    border-radius: 4dp;
}

scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec
{
    width: 0;
    height: 0;
}

/* The uninstall question: the same layer as the Quit Game question. */
#mod-confirm
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #000000b4;
}

#mod-confirm-box
{
    box-sizing: border-box;
    width: 700dp;
    padding: 26dp 30dp 30dp 30dp;
    text-align: center;
    background-color: #000000f2;
    border: 5dp #d1caaf;
    border-radius: 10dp;
}

#mod-confirm-title
{
    font-size: 32dp;
}

#mod-confirm-text
{
    margin: 14dp 0 26dp 0;
    font-size: 21dp;
    font-weight: normal;
    color: #e6e0c8;
}

#mod-confirm-buttons
{
    display: flex;
    flex-direction: row;
    justify-content: center;
}

#mod-confirm-buttons .button
{
    margin: 0 12dp;
}

/* Last, so that it wins over the display set on .panel above. */
.hidden
{
    display: none;
}

/* An id selector outranks a class: the question sets its own display, so it needs its own rule. */
#confirm.hidden,
#mod-confirm.hidden
{
    display: none;
}
