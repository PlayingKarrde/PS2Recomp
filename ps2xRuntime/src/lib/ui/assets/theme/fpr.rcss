/*
 * Theme "fpr": the overlay's look. It takes its colours from the menus of Fire Pro Wrestling Returns, and leaves its weight behind.
 *
 * What the game's own screens look like (from screenshots of its Options, wrestler select, edit and main menu):
 *   - near-black translucent panels over a busy yellow and grey background, with a cream border;
 *   - the cursor is a steel-blue bar across the row (#2c68a3 at the top to #4d8cc6), the row's text staying white;
 *   - a gold title band (#cba32c to #e7bc3d) and khaki bevelled buttons;
 *   - values at the right of a row in square brackets, "[Stereo]", "[85%]", "[OFF]", and a description of the highlighted
 *     row in a bar at the bottom.
 *
 * This theme keeps that palette (gold, steel blue, near-black, cream) and the bracketed values, and makes everything flatter and
 * quieter than the game itself: regular Lato instead of heavy italics, smaller type, one-pixel borders, flat fills instead of
 * bevels, no drop shadows, and the same spacing everywhere.
 *
 * The palette, so that a theme mod knows what to change:
 *   gold    #e7bc3d  (the title band, the focus edge, notes)      steel blue  #2c68a3 .. #4d8cc6  (the cursor, the selected tab)
 *   dark    #0b1019  (panels)                                      cream       #d1caaf  (borders, drawn faint)
 *   text    #f0ede0  (main)  #c4c0ae  (secondary)  #8f8c80  (disabled)
 *
 * The layout, at the design size of 720 dp high (1 dp = 1 pixel in a 720 pixel high window; Overlay::setViewport scales it):
 *   - #window is the whole window. The title band runs across all of it; everything below it is one column that is centred
 *     and at most 1280 dp wide, so on a very wide window lines do not get too long to read. On a narrower window the column
 *     is the window's width.
 *   - the column is a flex column: the tabs, the content box (.panel; the one that is showing takes all the room that is left),
 *     the restart note, the help line and the footer. The heights of everything but the content box are fixed here, so every
 *     tab has the same frame whatever it shows. A tab whose content is taller than its box scrolls inside it.
 *
 * Nothing from the game is used: the font is Lato (SIL OFL 1.1, ../fonts), the colours are measured from screenshots, the shapes
 * are RCSS. RmlUi limits the theme works within: no box-shadow or filters (the renderer has no offscreen layers), no rounded
 * clipping of overflow, so depth comes from borders and gradients.
 *
 * Theme mods (docs/formats/fprmod.md) add style sheets after this one. The rules a mod is likely to change keep the same selectors
 * as before: .tab.selected, .row / .mod / .mrow hover and focus, .button and .mbtn hover and focus, .row .fill, #header, #brand,
 * #page-title.
 */

/* RmlUi has no built-in HTML defaults: an element is inline unless told otherwise, which makes a div ignore its
   width and height. The samples ship rml.rcss for this; the theme needs only div. */
div
{
    display: block;
}

body
{
    font-family: LatoLatin;
    font-weight: normal;
    font-style: normal;
    font-size: 20dp;
    letter-spacing: 0.2dp;
    color: #f0ede0;
    width: 100%;
    height: 100%;
    /* A dim over the whole game picture, so the overlay reads as in front of it. */
    background-color: #04060cc4;
}

/* ---- The window and the title band ------------------------------------------------------------------------ */

#window
{
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
}

#header
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex: none;
    box-sizing: border-box;
    width: 100%;
    height: 38dp;
    padding: 0 24dp;
    decorator: linear-gradient(180deg, #e2b83c, #d0a62e);
}

#page-title
{
    font-size: 21dp;
    font-weight: bold;
    letter-spacing: 0.4dp;
    color: #1c1a14;
}

#brand
{
    font-size: 14dp;
    letter-spacing: 0.8dp;
    color: #4a3f1a;
}

/* Everything under the band: one column, centred, with a maximum width. */
#page
{
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    box-sizing: border-box;
    width: 100%;
    max-width: 1280dp;
    padding: 0 16dp 14dp 16dp;
}

/* ---- Tabs: plain labels over the content box; the current one has a gold underline, the focused one the blue cursor ---- */

#tabs
{
    display: flex;
    flex-direction: row;
    flex: none;
    height: 34dp;
    margin: 12dp 0 0 0;
}

.tab
{
    display: block;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 34dp;
    min-width: 112dp;
    margin-right: 4dp;
    padding: 0 22dp;
    line-height: 31dp;
    text-align: center;
    font-size: 18dp;
    font-weight: bold;
    color: #aeaa98;
    background-color: #ffffff0a;
    border-bottom: 3dp #00000000;
    border-top-left-radius: 4dp;
    border-top-right-radius: 4dp;
}

.tab:hover
{
    color: #ffffff;
    background-color: #ffffff18;
}

.tab.selected
{
    color: #ffffff;
    background-color: #ffffff14;
    border-bottom-color: #e7bc3d;
}

.tab:focus
{
    color: #ffffff;
    decorator: linear-gradient(180deg, #3a77b4, #2c68a3);
    border-bottom-color: #e7bc3d;
}

/* ---- The content box: dark, thin cream border. One per tab, all the same size. -------------------------------------- */

.panel
{
    display: block;
    flex: 1 1 0;
    min-height: 0;
    box-sizing: border-box;
    padding: 12dp;
    background-color: #0b1019eb;
    border: 1dp #d1caaf40;
    border-radius: 6dp;
}

.panel.hidden
{
    display: none;
}

.row
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 38dp;
    padding: 0 14dp 0 12dp;
    border-left: 3dp #00000000;
    border-radius: 3dp;
}

.row:hover,
.row:focus
{
    decorator: linear-gradient(180deg, #3673b0, #2c68a3);
    border-left-color: #e7bc3d;
}

.row .label
{
    flex: 1 1 0;
    color: #e6e2d2;
}

.row .value
{
    width: 150dp;
    text-align: right;
    color: #ffffff;
    font-weight: bold;
}

.row:hover .label,
.row:focus .label
{
    color: #ffffff;
}

/* A slider is a thin dark trough with a blue fill, between the label and the value. */
.row .slider
{
    width: 280dp;
    height: 10dp;
    margin-right: 18dp;
}

.row .track
{
    width: 100%;
    height: 10dp;
    box-sizing: border-box;
    background-color: #000000b0;
    border: 1dp #d1caaf80;
    border-radius: 5dp;
    overflow: hidden;
}

.row .fill
{
    width: 50%;
    height: 8dp;
    decorator: linear-gradient(180deg, #8ec7ff, #40a0ff 45%, #2a68a6);
}

.row:focus .track
{
    border-color: #ffffff;
}

/* A short word in a row ("ENV", "RESTART"); the space is kept so values do not move. */
.row .tag
{
    width: 96dp;
    margin-right: 10dp;
    text-align: right;
    font-size: 13dp;
    font-weight: bold;
    letter-spacing: 1dp;
    color: #e7bc3d;
}

/* A locked row can still be focused (the help line says why) but is dimmed. */
.row.locked .label,
.row.locked .value
{
    color: #8f8c80;
}

.row.locked .track
{
    border-color: #8f8c80;
}

.row.locked:hover .label,
.row.locked:focus .label,
.row.locked:hover .value,
.row.locked:focus .value
{
    color: #cfcbbb;
}

/* ---- The restart note, the help line and the footer ------------------------------------------------------------- */

#notice
{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex: none;
    height: 24dp;
    margin-top: 6dp;
    padding: 0 4dp;
    font-size: 15dp;
}

#restart-note
{
    color: #e7bc3d;
    letter-spacing: 0.3dp;
}

#help
{
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: none;
    box-sizing: border-box;
    height: 44dp;
    padding: 0 14dp;
    font-size: 17dp;
    color: #f0ede0;
    background-color: #0b1019eb;
    border: 1dp #d1caaf40;
    border-left: 3dp #e7bc3d;
    border-radius: 4dp;
}

#help-text
{
    flex: 1 1 0;
    min-width: 0;
}

#footer
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex: none;
    height: 34dp;
    margin-top: 10dp;
}

#hints
{
    font-size: 14dp;
    letter-spacing: 0.3dp;
    color: #c4c0ae;
}

#hints span
{
    margin-right: 20dp;
}

#footer-buttons
{
    display: flex;
    flex-direction: row-reverse; /* Back (first in the page) at the right edge, Quit Game on its left */
}

#quit
{
    margin-right: 8dp;
}

/* ---- Buttons: flat, dark, thin border; the focused one takes the blue cursor and the gold edge -------------------- */

.button
{
    display: block;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 34dp;
    min-width: 112dp;
    padding: 0 22dp;
    line-height: 32dp;
    text-align: center;
    font-size: 17dp;
    font-weight: bold;
    color: #f0ede0;
    decorator: linear-gradient(180deg, #2c3544, #252d3a);
    border: 1dp #d1caaf55;
    border-radius: 4dp;
}

.button:hover,
.button:focus
{
    color: #ffffff;
    decorator: linear-gradient(180deg, #3673b0, #2c68a3);
    border-color: #e7bc3d;
}

/* The small button beside the restart note (Restart Now). Hidden by the code when the note is. */
.button.compact
{
    display: none;
    height: 24dp;
    min-width: 0;
    padding: 0 14dp;
    line-height: 22dp;
    font-size: 14dp;
}

/* A button that cannot be used now (Quit Game while the game is writing to the memory card). It stays focusable, so the
   help line can say why. */
.button.locked
{
    color: #7d7a6e;
    decorator: linear-gradient(180deg, #232a35, #1f252f);
}

.button.locked:hover,
.button.locked:focus
{
    color: #cfcbbb;
    decorator: linear-gradient(180deg, #232a35, #1f252f);
    border-color: #d1caaf;
}

/* ---- The Controls tab: a read-only list ------------------------------------------------------------------------- */

.ctl
{
    display: flex;
    flex-direction: row;
    height: 24dp;
    padding: 0 14dp;
    font-size: 16dp;
}

.ctl .c-act
{
    width: 150dp;
}

.ctl .c-key
{
    width: 330dp;
    color: #c4c0ae;
}

.ctl .c-pad
{
    flex: 1 1 0;
}

.ctl.head
{
    height: 26dp;
    margin-bottom: 4dp;
    font-size: 14dp;
    font-weight: bold;
    letter-spacing: 1dp;
    color: #e7bc3d;
    border-bottom: 1dp #d1caaf40;
}

#controller-name
{
    margin-top: 10dp;
    padding: 0 14dp;
    font-size: 14dp;
    color: #c4c0ae;
}

/* ---- The questions: Quit Game, uninstall a mod, "Which save?" ---------------------------------------------------- */

/* While the question is up, nothing behind it takes the focus (the controller's directions would otherwise walk off the
   question into the settings). The mouse cannot reach the settings either: the question's dim layer covers them. */
#window.confirming
{
    focus: none;
}

#confirm,
#mod-confirm
{
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #04060ccc;
}

#confirm-box,
#mod-confirm-box
{
    box-sizing: border-box;
    width: 560dp;
    max-width: 90%;
    padding: 24dp 28dp 26dp 28dp;
    text-align: center;
    background-color: #0b1019;
    border: 1dp #d1caaf80;
    border-radius: 8dp;
}

#confirm-title,
#mod-confirm-title
{
    font-size: 23dp;
    font-weight: bold;
    letter-spacing: 0.3dp;
}

#confirm-text,
#mod-confirm-text
{
    margin: 12dp 0 22dp 0;
    font-size: 16dp;
    color: #c4c0ae;
}

#confirm-buttons,
#mod-confirm-buttons
{
    display: flex;
    flex-direction: row;
    justify-content: center;
}

#confirm-buttons .button,
#mod-confirm-buttons .button
{
    margin: 0 5dp;
}

/* ---- The Mods tab: a list of mods on the left, the details of the focused mod on the right ---------------------- */

/* The panel is a column: the list and the details take what is left, the status line and the foot are only as tall as their text. */
#panel-mods
{
    display: flex;
    flex-direction: column;
    padding: 10dp 12dp 8dp 12dp;
}

#panel-mods.hidden
{
    display: none;
}

#mods-body
{
    display: flex;
    flex-direction: row;
    flex: 1 1 0;
    min-height: 0;
}

#mods-list
{
    flex: none;
    width: 28%;
    min-width: 220dp;
    max-width: 320dp;
    min-height: 0;
    margin-right: 14dp;
    overflow-y: auto;
}

#mods-empty
{
    padding: 12dp;
    font-size: 16dp;
    color: #c4c0ae;
}

.mod
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 34dp;
    padding: 0 8dp 0 6dp;
    font-size: 17dp;
    border-left: 3dp #00000000;
    border-radius: 3dp;
}

.mod:hover,
.mod:focus
{
    decorator: linear-gradient(180deg, #3673b0, #2c68a3);
}

.mod.selected
{
    border-left-color: #e7bc3d;
}

.mod .m-pos
{
    width: 26dp;
    font-size: 13dp;
    color: #aeaa98;
}

.mod .m-name
{
    flex: 1 1 0;
    height: 24dp;
    overflow: hidden;
    white-space: nowrap;
}

.mod .m-flag
{
    width: 16dp;
    text-align: center;
    font-weight: bold;
    color: #e7bc3d;
}

.mod .m-state
{
    width: 40dp;
    text-align: right;
    font-size: 13dp;
    font-weight: bold;
    letter-spacing: 0.6dp;
    color: #8fd18f;
}

.mod.off .m-name,
.mod.off .m-state
{
    color: #8f8c80;
}

.mod.bad .m-name,
.mod.bad .m-state
{
    color: #ff9d8a;
}

.mod:hover .m-name,
.mod:focus .m-name,
.mod:hover .m-state,
.mod:focus .m-state
{
    color: #ffffff;
}

/* The details: one column. The text and the settings scroll; the buttons below stay in view. */
#mod-details
{
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
}

#mod-info
{
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
}

#mod-title
{
    height: 30dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 23dp;
    font-weight: bold;
}

#mod-meta
{
    height: 22dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 14dp;
    color: #c9b66b;
}

#mod-main
{
    display: flex;
    flex-direction: row;
    margin-top: 4dp;
}

#mod-text
{
    flex: 1 1 0;
    min-width: 0;
}

#mod-desc
{
    font-size: 16dp;
    color: #e6e2d2;
}

#mod-problem
{
    margin-top: 6dp;
    font-size: 15dp;
}

#mod-problem.bad
{
    color: #ff9d8a;
}

#mod-problem.warn
{
    color: #e7bc3d;
}

#mod-notes
{
    margin-top: 6dp;
    font-size: 14dp;
    color: #e7bc3d;
}

#mod-infonotes
{
    margin-top: 6dp;
    font-size: 14dp;
    color: #8fd18f;
}

.mod-notes-line
{
    margin-top: 2dp;
    font-size: 13dp;
    color: #e6e2d2;
}

#mod-links,
#mod-note
{
    margin-top: 6dp;
    font-size: 14dp;
    color: #aeaa98;
}

#mod-picbox
{
    width: 160dp;
    height: 90dp;
    margin: 2dp 0 0 14dp;
    overflow: hidden;
    border: 1dp #d1caaf80;
    background-color: #000000;
}

#mod-pic
{
    width: 158dp;
}

#mod-settings
{
    margin-top: 8dp;
}

.mrow
{
    display: flex;
    flex-direction: row;
    align-items: center;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 30dp;
    padding: 0 8dp 0 6dp;
    font-size: 16dp;
    border-left: 3dp #00000000;
    border-radius: 3dp;
}

.mrow:hover,
.mrow:focus
{
    decorator: linear-gradient(180deg, #3673b0, #2c68a3);
    border-left-color: #e7bc3d;
}

.mrow .label
{
    flex: 1 1 0;
}

.mrow .value
{
    width: 140dp;
    text-align: right;
    font-weight: bold;
}

#mod-actions
{
    display: flex;
    flex-direction: row;
    flex: none;
    height: 32dp;
    margin-top: 8dp;
}

.mbtn
{
    display: block;
    tab-index: auto;
    nav: auto;
    box-sizing: border-box;
    height: 32dp;
    min-width: 84dp;
    margin-right: 6dp;
    padding: 0 12dp;
    line-height: 30dp;
    font-size: 15dp;
    font-weight: bold;
    text-align: center;
    color: #f0ede0;
    decorator: linear-gradient(180deg, #2c3544, #252d3a);
    border: 1dp #d1caaf55;
    border-radius: 4dp;
}

.mbtn:hover,
.mbtn:focus
{
    color: #ffffff;
    decorator: linear-gradient(180deg, #3673b0, #2c68a3);
    border-color: #e7bc3d;
}

.mbtn.locked
{
    color: #7d7a6e;
    decorator: linear-gradient(180deg, #232a35, #1f252f);
}

.mbtn.locked:hover,
.mbtn.locked:focus
{
    color: #cfcbbb;
    decorator: linear-gradient(180deg, #232a35, #1f252f);
    border-color: #d1caaf;
}

#mods-status
{
    flex: none;
    min-height: 20dp;
    max-height: 38dp;
    margin-top: 6dp;
    overflow: hidden;
    font-size: 15dp;
    color: #e7bc3d;
}

/* The foot of the tab: the memory card line over the whole width (it may take two lines), then the folder lines at the left and the
   small buttons at the right. min-width: 0 lets the folder column shrink to what is left beside the buttons instead of growing to
   its text, which would run under them. */
#mods-foot
{
    display: block;
    flex: none;
    margin-top: 4dp;
}

#mods-card
{
    min-height: 18dp;
    max-height: 34dp;
    overflow: hidden;
    font-size: 13dp;
    color: #c4c0ae;
}

/* Load Now and the line beside it: shown by the code only while there is something to say or do. */
#mods-apply
{
    display: none;
    flex-direction: row;
    align-items: center;
    margin-top: 4dp;
}

/* The button first, at the left edge under the list: the controller reaches it with Down from the list or the mod's buttons. */
#mods-apply .mbtn.small
{
    flex: none;
    margin-left: 0;
}

#mods-load-note
{
    flex: 1 1 0;
    min-width: 0;
    margin-left: 12dp;
    height: 20dp;
    line-height: 20dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 14dp;
    color: #e7bc3d;
}

#mods-lower
{
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 2dp;
}

#mods-paths
{
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
}

#mods-folder,
#dev-folder
{
    height: 18dp;
    overflow: hidden;
    white-space: nowrap;
    font-size: 13dp;
    color: #aeaa98;
}

#mods-tools
{
    display: flex;
    flex-direction: row;
    flex: 0 0 auto;
    margin-left: 12dp;
}

.mbtn.small
{
    min-width: 0;
    height: 28dp;
    margin-right: 0;
    margin-left: 5dp;
    padding: 0 12dp;
    line-height: 26dp;
    font-size: 13dp;
}

/* Scroll bars (a list or a details page longer than its box): a thin trough and the blue thumb of the game's own lists. */
scrollbarvertical
{
    width: 8dp;
}

scrollbarvertical slidertrack
{
    background-color: #00000070;
    border-radius: 4dp;
}

scrollbarvertical sliderbar
{
    width: 8dp;
    min-height: 24dp;
    background-color: #40a0ff;
    border-radius: 4dp;
}

scrollbarvertical sliderarrowinc,
scrollbarvertical sliderarrowdec
{
    width: 0;
    height: 0;
}

/* Last, so that it wins over the display set on the rules above. */
.hidden
{
    display: none;
}

/* An id selector outranks a class: the questions set their own display, so they need their own rule. */
#confirm.hidden,
#mod-confirm.hidden
{
    display: none;
}
